# ── DomainSentinel — Configuration ──────────────────────────────────────────
# Copie ce fichier en .env et remplis les valeurs.
# Ne JAMAIS commiter le .env réel.

# ── Cloudflare ───────────────────────────────────────────────────────────────
# Token API Cloudflare (lecture seule, permission Zone / DNS : Read)
# Créer dans Cloudflare Dashboard → Profile → API Tokens → Create Custom Token
# Permissions: Zone / DNS / Read
CLOUDFLARE_TOKEN=

# Zone DNS à surveiller (le domaine principal)
CLOUDFLARE_ZONE_NAME=techsentinel.fr

# Timeout pour les appels API Cloudflare (secondes)
CLOUDFLARE_TIMEOUT_S=15

# ── Application ──────────────────────────────────────────────────────────────
DS_HOST=0.0.0.0
DS_PORT=3000
DS_DATA_DIR=/data
DS_CONFIG_DIR=/config
DS_LOG_LEVEL=INFO   # DEBUG pour verbose, INFO pour production

# ── Scanner ─────────────────────────────────────────────────────────────────
# Intervalle entre chaque scan complet (secondes)
SCANNER_INTERVAL_S=30

# ── Healthcheck ──────────────────────────────────────────────────────────────
# Timeout par requête HTTP (secondes)
HEALTHCHECK_TIMEOUT_S=10
# Nombre de checks parallèles
HEALTHCHECK_CONCURRENCY=10
# Intervalle entre les healthchecks (secondes)
HEALTHCHECK_INTERVAL_S=60

# ── Persistance ──────────────────────────────────────────────────────────────
# Nombre de jours de rétention de l'historique
HISTORY_RETENTION_DAYS=30
